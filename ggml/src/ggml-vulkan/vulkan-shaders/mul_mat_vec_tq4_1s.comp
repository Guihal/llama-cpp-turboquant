#version 450

#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_KHR_shader_subgroup_shuffle : enable

#include "mul_mat_vec_tq4_1s.glslh"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

// TQ4_1S matvec dispatch (verified 2026-06-23 against ggml-vulkan.cpp:4351,4360):
//   - tq4_1s_wg_size          = 32  → wave32 path: compute_outputs() below (NUM_COLS>1
//                                    prefill) AND compute_outputs() in the MUL_MAT_ID
//                                    pipeline.
//   - tq4_1s_decode_wg_size   = 64  → wave64 path: compute_outputs_cacheline() defined
//                                    in mul_mat_vec_tq4_1s.glslh (owned by another agent,
//                                    out of scope here). Selected when NUM_COLS==1.
//
// PR #21751 coalesced 12-byte scale/d0/d1 read (the top finding in
// docs/tq4-accel-research/specs/042-research-quant.md) lives in compute_outputs()
// at lines ~95-99 below (wave32 / prefill / MUL_MAT_ID). Verified mathematically:
// tid in [0,32) → (tid >> 4) is 0 for tid<16 and 1 for tid>=16, exactly the d0/d1
// split, and the array-index form defeats mesa's unsigned-upper-bound ternary
// coalescing failure.
//
// Wave64 decode (compute_outputs_cacheline in the glslh) currently uses the
// un-coalesced (tid_in_half < 16u) ? d0 : d1 ternary antipattern. Deferred —
// the glslh is another agent's territory.
//
// No additional .glslh header is needed: the existing mul_mat_vec_tq4_1s.glslh
// supplies compute_outputs_cacheline, TQ4_CENTROIDS_SCALED, TQ4_SIGNS, and the
// shared base.

// See the commit message on a850ccc for the full derivation and portability
// rationale.  Short version: pre-rotate the activation block via forward WHT
// in shared memory, then dot-product against the raw centroid*scale weights.
//
// Shared memory budget: NUM_COLS * 32 floats (max 1 KiB at NUM_COLS=8)
// plus whatever tmpsh the reduction helper allocates.

shared float tq4_smem[8 * 32];

// ponytail: for decode (NUM_COLS=1), use subgroupShuffleXor WHT — no shared
// memory, no barriers. For NUM_COLS>1, fall back to shared-memory WHT.
// This is the biggest single win for decode occupancy: removes 5 barriers
// per block + 256 floats of shared memory.
void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
    const uint tid = gl_LocalInvocationID.x;

    uint a_offset, b_offset, d_offset;
    get_offsets(a_offset, b_offset, d_offset);

    FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];
    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
            temp[j][n] = FLOAT_TYPE(0);
        }
    }

    const uint num_blocks_per_row = p.ncols / 32u;
    const uint byte_idx     = tid / 2u;
    const uint nibble_shift = (tid & 1u) * 4u;
    const float sign_tid    = TQ4_SIGNS[tid];

    // ponytail: precompute weight base address outside loop — saves 1 mul + 1 add per block.
    const uint w_base = a_offset + first_row * num_blocks_per_row;

    for (uint blk = 0; blk < num_blocks_per_row; blk++) {
        // --- Load activation into register (shared across all columns) ---
        const uint b_base = b_offset + blk * 32u;
        float activation[NUM_COLS];
        [[unroll]] for (uint c = 0; c < NUM_COLS; ++c) {
            activation[c] = float(data_b[c * p.batch_stride_b + b_base + tid]) * sign_tid;
        }

        // --- WHT butterfly ---
        // Decode (NUM_COLS=1): subgroupShuffleXor — 0 barriers, 0 shared memory.
        // Prefill (NUM_COLS>1): shared memory — 1 barrier per stage.
        if (NUM_COLS == 1u) {
            // ponytail: subgroup WHT — each thread holds 1 element in a register.
            // subgroupShuffleXor exchanges with the butterfly partner directly.
            [[unroll]] for (uint step = 1u; step < 32u; step <<= 1u) {
                const float partner_val = subgroupShuffleXor(activation[0], step);
                activation[0] = ((tid & step) == 0u)
                    ? (activation[0] + partner_val)
                    : (partner_val - activation[0]);
            }
        } else {
            // Write to shared memory
            [[unroll]] for (uint c = 0; c < NUM_COLS; ++c) {
                tq4_smem[c * 32u + tid] = activation[c];
            }
            barrier();
            // Butterfly in shared memory
            [[unroll]] for (uint step = 1u; step < 32u; step <<= 1u) {
                if ((tid & step) == 0u) {
                    const uint partner = tid + step;
                    [[unroll]] for (uint c = 0; c < NUM_COLS; ++c) {
                        const uint base = c * 32u;
                        const float a = tq4_smem[base + tid];
                        const float b = tq4_smem[base + partner];
                        tq4_smem[base + tid]     = a + b;
                        tq4_smem[base + partner] = a - b;
                    }
                }
                barrier();
            }
            // Read back
            [[unroll]] for (uint c = 0; c < NUM_COLS; ++c) {
                activation[c] = tq4_smem[c * 32u + tid];
            }
        }

        // --- Stage 3: dequant weights ---
        float w_vals[NUM_ROWS];
        for (uint n = 0; n < num_rows; ++n) {
            const uint ib   = w_base + n * num_blocks_per_row + blk;
            // ponytail: PR #21751 coalesce — read both fp16 scales unconditionally
            // (adjacent fields, 4-byte aligned in the 20-byte block → mesa coalesces to one
            // 32-bit SSBO load). Then index via constant array. Eliminates the `?:` ternary
            // that mesa's unsigned-upper-bound analysis can't fold (forces 3 un-coalesced
            // loads). tid >> 4u == (tid < 16u ? 0 : 1) for tid in [0, 32).
            //
            // Verified for wave32 (the only WG size that runs this body per
            // tq4_1s_wg_size=32 dispatch in ggml-vulkan.cpp:4351).
            const float d0 = float(data_a[ib].d0);
            const float d1 = float(data_a[ib].d1);
            const float ds[2] = float[2](d0, d1);
            const float d  = ds[tid >> 4u];
            const uint qbyte = uint(data_a[ib].qs[byte_idx]);
            const uint idx   = (qbyte >> nibble_shift) & 0xFu;
            w_vals[n] = TQ4_CENTROIDS_SCALED[idx] * d;
        }

        // --- Stage 4: accumulate dot products ---
        [[unroll]] for (uint c = 0; c < NUM_COLS; ++c) {
            for (uint n = 0; n < num_rows; ++n) {
                temp[c][n] += FLOAT_TYPE(w_vals[n] * activation[c]);
            }
        }
    }



    reduce_result(temp, d_offset, first_row, num_rows, tid);
}

void main() {
    const uint first_row = NUM_ROWS * (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z);

#if !defined(MUL_MAT_ID)
    // Decode (NUM_COLS=1): cacheline-coalesced body. ID compile strips this branch entirely.
    if (NUM_COLS == 1u) {
        if (first_row + NUM_ROWS <= p.stride_d) {
            compute_outputs_cacheline(first_row, NUM_ROWS);
        } else if (first_row < p.stride_d) {
            compute_outputs_cacheline(first_row, p.stride_d - first_row);
        }
        return;
    }
#endif

    if (first_row + NUM_ROWS <= p.stride_d) {
        compute_outputs(first_row, NUM_ROWS);
    } else {
        if (first_row >= p.stride_d) {
            return;
        }
        compute_outputs(first_row, p.stride_d - first_row);
    }
}
